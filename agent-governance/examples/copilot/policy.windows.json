{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "powershell -NoProfile -EncodedCommand ",
        "timeoutSec": 1800,
        "timeout": 1800
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "powershell -NoProfile -EncodedCommand ",
        "timeoutSec": 30,
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "powershell -NoProfile -EncodedCommand ",
        "timeoutSec": 30,
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "powershell -NoProfile -EncodedCommand ",
        "timeoutSec": 30,
        "timeout": 30
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "command": "powershell -NoProfile -EncodedCommand ",
        "timeoutSec": 30,
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -EncodedCommand ",
        "timeoutSec": 30,
        "timeout": 30
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "powershell -NoProfile -EncodedCommand ",
        "timeoutSec": 30,
        "timeout": 30
      }
    ]
  }
}
